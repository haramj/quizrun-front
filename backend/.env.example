# 복사해서 .env로 쓰세요 (.env는 gitignore 대상입니다. 절대 커밋하지 마세요)
# CLOVA Studio > API 키 관리에서 발급한 키 (nv- 로 시작)
NCP_CLOVA_API_KEY=nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 관리자 API(문제 비활성화/복구) 토큰. 비우면 관리자 API가 꺼집니다. 길고 예측 불가능한 값을 쓰세요
ADMIN_TOKEN=change-me-to-a-long-random-string

# 서로 다른 신고자가 이 횟수에 도달하면 문제를 자동으로 출제에서 제외 (기본 3)
# REPORT_THRESHOLD=3

# docker-compose.scale.yml(서버 2대 + LB 검증용)에서 쓰는 로컬 MySQL 비밀번호. 임의의 긴 값을 쓰세요
MYSQL_PASSWORD=change-me-too

# --- 서버 여러 대(수업 Day4 무상태 설계) ---
# SPRING_PROFILES_ACTIVE=redis 로 켜면 방 상태를 Cloud DB for Cache(Redis)에 둔다. 서버 1대·로컬은 비워 둔다.
# SPRING_PROFILES_ACTIVE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
